    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-browser-dynamic": "^22.0.7",
    "@angular/ssr": "^22.0.7",
    "@floating-ui/dom": "^1.8.0",
    "rxjs": "^7.4.0",
    "tslib": "^2.8.1",
    "typewriter-effect": "^2.22.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.7",
    "@angular-devkit/build-ng-packagr": "^0.1002.0",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@angular/language-service": "^22.0.7",
    "@types/eslint": "9.6.1",
    "@types/node": "^18.13.0",
    "@types/prismjs": "^1.16.5",
    "@types/semver": "^7.3.13",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/browser-playwright": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.28.0",
    "gulp": "^4.0.2",
    "gulp-sass": "^5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.1",
    "plugin-log": "^0.1.0",
    "prismjs": "^1.30.0",
    "puppeteer": "^24.10.0",
    "semver": "^7.6.2",
    "through2": "^4.0.2",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
